# Welcome to Nigeria Travel Magazine - Environment Variables
# Copy this file to .env and adjust values for your environment.

SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,magazine.welcometonigeria.com

# Database URL
# SQLite local development default:
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL production example:
# DATABASE_URL=postgres://user:password@localhost:5432/wtn_magazine

# Email Settings (for contact notifications and password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=editor@welcometonigeria.com
CONTACT_NOTIFICATION_EMAIL=editor@welcometonigeria.com

# CORS / CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://magazine.welcometonigeria.com

